<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AnyRadianceLoader</AssemblyName>
    <RootNamespace>AnyRadianceLoader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <HollowKnightManaged Condition="'$(HollowKnightManaged)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Hollow Knight\hollow_knight_Data\Managed</HollowKnightManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(HollowKnightManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(HollowKnightManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(HollowKnightManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Embedded\AnyRadianceFixedDDark\AnyRadiance.dll" LogicalName="v1/AnyRadiance.dll" />
    <EmbeddedResource Include="Embedded\AnyRadiance2-1.5\AnyRadiance.dll" LogicalName="v2/AnyRadiance.dll" />
    <EmbeddedResource Include="Embedded\AnyRadiance2-1.5\AnyRadiance.pdb" LogicalName="v2/AnyRadiance.pdb" />
    <EmbeddedResource Include="Embedded\Any_Radiance_3_0\AnyRadiance.dll" LogicalName="v3/AnyRadiance.dll" />
    <EmbeddedResource Include="Embedded\Any_Radiance_3_0\AnyRadiance.pdb" LogicalName="v3/AnyRadiance.pdb" />
    <EmbeddedResource Include="Embedded\ModCommon\ModCommon_1.5.dll" LogicalName="ModCommon/ModCommon_1.5.dll" />
  </ItemGroup>
</Project>
